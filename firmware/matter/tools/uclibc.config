TARGET_mips=y
ARCH_BIG_ENDIAN=y
ARCH_USE_MMU=y
CONFIG_MIPS_O32_ABI=y
CONFIG_MIPS_NAN_LEGACY=y
# UCLIBC_USE_MIPS_PREFETCH is not set
# UCLIBC_HAS_STRING_ARCH_OPT is not set
# UCLIBC_HAS_FPU is not set
UCLIBC_HAS_FLOATS=y
DO_C99_MATH=y
# HAVE_SHARED is not set
UCLIBC_HAS_LINUXTHREADS=y
# UCLIBC_HAS_THREADS_NATIVE is not set
# UCLIBC_HAS_TLS is not set
# UCLIBC_USE_TIME64 is not set
PTHREADS_STACK_DEFAULT_SIZE=131072
UCLIBC_HAS_IPV6=y
UCLIBC_USE_NETLINK=y
UCLIBC_SUPPORT_AI_ADDRCONFIG=y
UCLIBC_HAS_WCHAR=y
UCLIBC_HAS_GNU_ERROR=y
UCLIBC_HAS_GNU_GETOPT=y
UCLIBC_HAS_GNU_GLOB=y
UCLIBC_HAS_ADVANCED_REALTIME=y
UCLIBC_HAS_NETWORK_SUPPORT=y
UCLIBC_HAS_SOCKET=y
UCLIBC_HAS_CTOR_DTOR=y
UCLIBC_SUSV3_LEGACY=y
UCLIBC_SUSV4_LEGACY=y
# UCLIBC_HAS_STDIO_FUTEXES is not set
KERNEL_HEADERS="/work/toolchains/uclibc/mips-linux-uclibc/usr/include"
RUNTIME_PREFIX="/"
DEVEL_PREFIX="/usr/"
CROSS_COMPILER_PREFIX="/work/deps/musl-cross-make/output/bin/mips-linux-musl-"
UCLIBC_EXTRA_CFLAGS="-Os -mno-llsc -mno-load-store-pairs -ffunction-sections -fdata-sections"
# UCLIBC_HAS_SSP is not set
