#!/bin/sh
# Firmware starts only this MCU owner; the V2 executable is retained for recovery.
if [ -n "$(/bin/pidof homekitserver 2>/dev/null)" ]; then
    echo 'MCU_OWNER_CONFLICT: HomeKit is running; Matter relay not started' > /var/log/matter-test.log
    exit 1
fi
(
    if [ ! -f /var/run/ck-rescue ] && /bin/matter-diag --run-probe; then
        /bin/matter-diag --run-matter
        echo "matterd-test_exit=$?; switching to local button control"
    fi
    # Keep one MCU owner even when persistent identity or Matter initialization
    # fails. This mode needs no pairing identity, Flash writes, or networking.
    echo 'MCU_ONLY: network application unavailable; physical button remains active'
    touch /var/run/ck-mcu-only
    exec /bin/matter-diag --run-hardware
) 2>&1 | /bin/matter-diag --log
