import("//build_overrides/chip.gni")
chip_build_tests = false
chip_build_tools = false
chip_enable_wifi = false
chip_enable_ethernet = false
chip_enable_thread = false
chip_enable_ble = false
chip_config_network_layer_ble = false
chip_mdns = "minimal"
chip_crypto = "mbedtls"
chip_detail_logging = false
chip_automation_logging = false
chip_data_model_extra_logging = false
chip_persist_subscriptions = false
chip_enable_ota_requestor = true
chip_with_lwip = false
enable_pie = false

chip_enable_read_client = true
chip_enable_transport_trace = false
chip_project_config_include = "<matter-app-device/CHIPProjectConfig.h>"
chip_project_config_include_dirs = [ "/work/src", "${chip_root}/config/standalone" ]
chip_system_project_config_include = "<SystemProjectConfig.h>"
